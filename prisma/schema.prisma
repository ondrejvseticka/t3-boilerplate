generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    SUPER_ADMIN
    ADMIN
    MEMBER
}

enum ActionType {
    STOKE
    WOOD
    COAL
    NIGHT
    ASH
    OUT
}

model User {
    id          String      @id @default(cuid())
    name        String
    email       String      @unique
    password    String
    role        Role        @default(MEMBER)
    avatarColor String      @default("#FF6B00")
    invitedById String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    logs        BoilerLog[]
    invitations Invitation[] @relation("CreatedInvitations")
}

model Invitation {
    id          String    @id @default(cuid())
    email       String
    token       String    @unique @default(cuid())
    role        Role      @default(MEMBER)
    name        String?
    createdById String
    createdBy   User      @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)
    expiresAt   DateTime
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())

    @@index([token])
    @@index([email])
}

model BoilerState {
    id             String     @id @default("main")
    lastActionType ActionType @default(OUT)
    lastUserName   String     @default("Nobody")
    lastFuelAt     DateTime?
    nextCheckAt    DateTime?
    note           String     @default("")
    updatedAt      DateTime   @updatedAt
}

model BoilerLog {
    id              String     @id @default(cuid())
    userId          String
    user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    userName        String
    actionType      ActionType
    durationMinutes Int        @default(0)
    createdAt       DateTime   @default(now())

    @@index([createdAt])
    @@index([userId])
}

model BoilerSettings {
    id           String @id @default("main")
    stokeMinutes Int    @default(180)
}

# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# If running locally using Docker, run `./start-database.sh` or `docker compose up -d`
DATABASE_URL="postgresql://postgres:password@localhost:5432/t3_boilerplate"

# ==============================================================================
# NextAuth.js Configuration (v5 JWT Strategy)
# ==============================================================================
# You can generate a new secret on the command line with:
# npx auth secret
# Or: openssl rand -base64 33
AUTH_SECRET="your-nextauth-secret-key-at-least-32-chars-long"

# More providers in here e.g.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ==============================================================================
# Resend & React Email Configuration
# ==============================================================================
# Get your API key at https://resend.com
# If left empty in development, emails will be simulated and logged directly to the console with the reset link.
RESEND_API_KEY=""
EMAIL_FROM="T3 Boilerplate <onboarding@resend.dev>"

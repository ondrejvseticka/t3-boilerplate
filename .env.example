# ==============================================================================
# Kotelna - Environment Configuration (.env.example)
# Copy this file to ".env" and fill in your secrets:
# cp .env.example .env
# ==============================================================================

# 1. Database Connection (PostgreSQL)
# If using the local Docker container (docker compose up -d):
DATABASE_URL="postgresql://postgres:password@localhost:5432/kotelna"

# 2. NextAuth.js Secret (JWT Strategy)
# Random secret string for signing JWT tokens (min 32 characters).
# Generate using: openssl rand -base64 33
AUTH_SECRET="your-random-nextauth-secret-key-at-least-32-chars-long"

# 3. Environment Mode
NODE_ENV="development"
